{
  "name": "diffwise",
  "displayName": "Diffwise",
  "description": "Generate commit messages with AI",
  "version": "0.0.7",
  "publisher": "sirj0k3r",
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^7.0.2"
  },
  "activationEvents": ["onCommand:diffwise.generate", "onCommand:diffwise.selectModel"],
  "contributes": {
    "commands": [
      {
        "command": "diffwise.generate",
        "title": "Generate Commit Message",
        "icon": "$(comment-discussion-sparkle)"
      },
      {
        "command": "diffwise.selectModel",
        "title": "Diffwise: Select Model"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "diffwise.generate",
          "when": "scmProvider == git && !diffwise.generating",
          "group": "navigation"
        },
        {
          "command": "diffwise.selectModel",
          "when": "scmProvider == git",
          "group": "1_diffwise"
        }
      ]
    },
    "configuration": {
      "title": "Diffwise",
      "properties": {
        "diffwise.model": {
          "type": "string",
          "enum": ["haiku", "sonnet"],
          "enumDescriptions": [
            "Fast, cheap. Good for most diffs.",
            "Slower, better on large or subtle diffs."
          ],
          "default": "haiku",
          "scope": "resource",
          "description": "Model alias passed to the Claude CLI."
        }
      }
    }
  },
  "icon": "src/images/icon.png",
  "repository": {
    "url": "https://github.com/sirj0k3r/diffwise"
  }
}
